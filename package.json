{
  "name": "swiss-ai-resource",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/sync-survey-aggregates.ts && tsx scripts/build-downloads.ts",
    "build:downloads": "tsx scripts/build-downloads.ts",
    "build": "next build",
    "postbuild": "tsx scripts/csp-hashes.ts",
    "start": "next start",
    "lint": "eslint .",
    "check:content": "tsx scripts/check-content.ts",
    "check:anchors": "tsx scripts/check-anchors.ts",
    "sync:anchors": "tsx scripts/sync-anchors.ts",
    "check:vendors": "tsx scripts/check-vendors.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "check:glossary": "tsx scripts/check-glossary.ts",
    "check:rules": "tsx scripts/check-rules.ts",
    "check:readiness": "tsx scripts/check-readiness.ts",
    "check:scanner": "tsx scripts/check-scanner.ts",
    "check:survey": "tsx scripts/check-survey.ts",
    "check:survey-answers": "tsx scripts/check-survey-answers.ts",
    "check:survey-aggregates": "tsx scripts/check-survey-aggregates.ts",
    "evaluate:survey": "tsx scripts/evaluate-survey-instrument.ts",
    "test:survey-worker": "tsx scripts/test-survey-worker.ts",
    "seed:survey-pipeline": "tsx scripts/seed-survey-pipeline.ts",
    "sync:survey-aggregates": "tsx scripts/sync-survey-aggregates.ts",
    "generate:e2e-survey-aggregates": "tsx scripts/generate-e2e-survey-aggregates.ts",
    "check:classify": "tsx scripts/check-classify.ts",
    "check:act": "tsx scripts/check-act.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:links-report": "tsx scripts/check-links-report.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:live-headers": "tsx scripts/check-live-headers.ts",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "aggregate:survey": "tsx scripts/aggregate-survey.ts",
    "snapshot:sources": "tsx scripts/snapshot-sources.ts",
    "classify:snapshots": "tsx scripts/classify-snapshots.ts",
    "maintain:act": "tsx scripts/maintain-act.ts",
    "changed-de-slugs": "tsx scripts/changed-de-slugs.ts",
    "translate": "tsx scripts/translate.ts",
    "translate:templates": "tsx scripts/translate-templates.ts",
    "translate:readiness": "tsx scripts/translate-readiness.ts",
    "dev:survey": "wrangler dev -c workers/survey/wrangler.jsonc",
    "deploy:survey": "wrangler deploy -c workers/survey/wrangler.jsonc",
    "db:survey:local": "wrangler d1 migrations apply swiss-ai-survey --local -c workers/survey/wrangler.jsonc",
    "dev:scanner": "wrangler dev -c workers/scanner/wrangler.jsonc",
    "deploy:scanner": "wrangler deploy -c workers/scanner/wrangler.jsonc",
    "build:e2e": "tsx scripts/build-e2e.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "docx": "^9.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jszip": "^3.10.2",
    "sharp": "0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  }
}
