{
  "name": "swiss-ai-survey",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Custom hostname api.aicompliant.ch is live; workers.dev disabled (OPERATOR §2.8).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.aicompliant.ch/submit*",
      "zone_name": "aicompliant.ch"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swiss-ai-survey",
      "database_id": "f98b464c-7aef-4319-86b2-7829b17f3c45",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SURVEY_RATE_LIMITER",
      "namespace_id": "2301",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    // Publish anonymized survey aggregates every Monday at 05:00 UTC.
    "crons": ["0 5 * * 1"]
  },
  "analytics_engine_datasets": [
    {
      // Anonymous tool-usage counter (src/lib/usage-metrics.ts): tool, outcome, status only.
      "binding": "USAGE",
      "dataset": "aicompliant_usage"
    }
  ],
  // Secrets (`wrangler secret put <NAME> -c workers/survey/wrangler.jsonc`,
  // never in git; local dev reads them from .dev.vars):
  //   TURNSTILE_SECRET_KEY  Turnstile siteverify secret.
  //   GITHUB_TOKEN          PAT for the weekly aggregates write (see T43).
  //   IP_HASH_SECRET        HMAC key for the daily per-IP quota hash in
  //                         submission_quotas (random, >= 32 bytes). /submit
  //                         returns 500 without it. Rotating it only resets
  //                         the current day's counters. See DEPLOY.md.
  "vars": {
    "SITE_ORIGIN": "https://aicompliant.ch",
    // Dedicated data-only repo (see DEPLOY.md "PAT blast radius" note):
    // GITHUB_TOKEN is scoped to just this repo, not swiss-ai-resource.
    "GITHUB_REPO": "Ivan-Laube/swiss-ai-survey-data",
    "GITHUB_BRANCH": "main",
    "GITHUB_AGGREGATES_PATH": "survey-aggregates.json"
  }
}
