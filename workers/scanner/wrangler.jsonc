{
  "name": "swiss-ai-scanner",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // Custom hostname api.aicompliant.ch is live; workers.dev disabled (OPERATOR §2.8).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.aicompliant.ch/scan*",
      "zone_name": "aicompliant.ch"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "ratelimits": [
    {
      "name": "SCANNER_RATE_LIMITER",
      "namespace_id": "2302",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://aicompliant.ch"
  }
}
