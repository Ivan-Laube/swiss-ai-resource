# Local secrets (not committed)

ANTHROPIC_API_KEY=
TRANSLATE_MODEL=
CLASSIFY_MODEL=

# Canonical site URL (build-time; used for canonical + hreflang tags,
# sitemap.xml, and robots.txt). Production: https://aicompliant.ch —
# also set this on Cloudflare Pages.
# Code default if unset: src/lib/site.ts → https://aicompliant.ch
NEXT_PUBLIC_SITE_URL=https://aicompliant.ch

# Survey form (T24) — Pages / Next public env
# Local Worker URL while developing: http://127.0.0.1:8787
# Production values (Pages): see DEPLOY.md — Worker https://swiss-ai-survey.i-laube.workers.dev
# For form UI testing, also start the Worker with:
#   npx wrangler dev -c workers/survey/wrangler.jsonc --var SITE_ORIGIN:http://localhost:3000
NEXT_PUBLIC_SURVEY_API_URL=
# Cloudflare Turnstile site key (test always-pass: 1x00000000000000000000AA)
# Production site key is set on Cloudflare Pages (widget swiss-ai-survey-v2; T23e done)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Website Quick-Check (T36) — Pages / Next public env
# Local Worker URL while developing: http://127.0.0.1:8787
# Production (Pages): https://swiss-ai-scanner.i-laube.workers.dev — see DEPLOY.md
# Start the scanner with SITE_ORIGIN matching the Next origin (Origin enforced on POST):
#   npx wrangler dev -c workers/scanner/wrangler.jsonc --var SITE_ORIGIN:http://localhost:3000
# If survey and scanner both run locally, assign different ports (e.g. scanner on 8788).
NEXT_PUBLIC_SCAN_API_URL=
